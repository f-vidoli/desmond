{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desmond",
  "version": "0.1.0",
  "identifier": "com.desmond.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Desmond",
        "width": 1180,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
